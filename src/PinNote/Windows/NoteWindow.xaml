<Window x:Class="PinNote.Windows.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PinNote"
        Width="360" Height="420" MinWidth="280" MinHeight="260"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        LocationChanged="Window_GeometryChanged"
        SizeChanged="Window_GeometryChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ReminderChipStyle" TargetType="Button">
            <Setter Property="Height" Value="30" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Background" Value="#0E000000" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#1A147D76" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ReminderLevelStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34" /><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Root" Background="#08000000" BorderBrush="#18000000" BorderThickness="1" CornerRadius="4" Margin="2">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#12000000" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#20147D76" /><Setter TargetName="Root" Property="BorderBrush" Value="#70147D76" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="FrameBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="0"
            Background="Transparent" ClipToBounds="False">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#0C000000" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE710;"
                        ToolTip="新建便签" Click="NewNote_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Border Grid.Column="1" Width="24" Height="28" Background="Transparent" Cursor="SizeAll"
                        ToolTip="拖动便签" MouseLeftButtonDown="DragGrip_MouseLeftButtonDown" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="⠿" FontSize="16" Foreground="#7A626A70" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBox x:Name="TitleBox" Grid.Column="2" Margin="2,4" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                         TextChanged="TitleBox_TextChanged" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE823;"
                        ToolTip="设置提醒" Click="ToggleReminderPanel_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="PinButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE718;"
                        ToolTip="切换桌面/全局置顶" Click="PinButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                        ToolTip="隐藏便签" Click="HideNote_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Grid Grid.Row="1" Background="#08000000">
                <StackPanel Orientation="Horizontal" Margin="6,2">
                    <ToggleButton x:Name="BoldButton" Style="{StaticResource ToolToggleStyle}" Content="B" ToolTip="粗体"
                                  Click="Bold_Click" />
                    <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToolToggleStyle}" Content="I" FontStyle="Italic"
                                  ToolTip="斜体" Click="Italic_Click" />
                    <ToggleButton x:Name="UnderlineButton" Style="{StaticResource ToolToggleStyle}" Content="U"
                                  ToolTip="下划线" Click="Underline_Click" />
                    <ToggleButton Style="{StaticResource ToolToggleStyle}" Content="•" FontSize="20"
                                  ToolTip="项目符号" Click="Bullets_Click" />
                    <Button Width="26" Height="26" Margin="6,2,2,2" Background="#202428" BorderBrush="#30202428"
                            ToolTip="深色文字" Click="InkDark_Click" />
                    <Button Width="26" Height="26" Margin="2" Background="#147D76" BorderBrush="#30147D76"
                            ToolTip="青色文字" Click="InkTeal_Click" />
                    <Button Width="26" Height="26" Margin="2" Background="#C95B52" BorderBrush="#30C95B52"
                            ToolTip="珊瑚色文字" Click="InkCoral_Click" />
                </StackPanel>
            </Grid>

            <RichTextBox x:Name="Editor" Grid.Row="2" Margin="8,4,8,2" Padding="6" BorderThickness="0"
                         Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                         FontSize="15" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                         TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged" />

            <Border x:Name="ReminderPanel" Grid.Row="3" Visibility="Collapsed" Background="#F2FAFCFC"
                    BorderBrush="#22000000" BorderThickness="0,1,0,1" Padding="12,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="设置提醒" FontWeight="SemiBold" />
                            <TextBlock Text="选择时间与提醒强度" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="28" Height="28" Background="Transparent" BorderBrush="Transparent" Content="&#xE711;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="收起" Click="ToggleReminderPanel_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource ReminderChipStyle}" Content="1 小时后" Tag="hour" Click="QuickReminder_Click" />
                        <Button Style="{StaticResource ReminderChipStyle}" Content="今天 18:00" Tag="today" Click="QuickReminder_Click" />
                        <Button Style="{StaticResource ReminderChipStyle}" Content="明天 09:00" Tag="tomorrow" Click="QuickReminder_Click" />
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="ReminderDate" Grid.Column="0" Height="32" Background="White" BorderBrush="#CBD3D6" />
                        <ComboBox x:Name="ReminderHour" Grid.Column="1" Height="32" VerticalContentAlignment="Center" />
                        <ComboBox x:Name="ReminderMinute" Grid.Column="3" Height="30" VerticalContentAlignment="Center" />
                    </Grid>
                    <UniformGrid Columns="2" Rows="2" Margin="-2,0,-2,8">
                        <RadioButton x:Name="LevelWeak" GroupName="ReminderLevel" Style="{StaticResource ReminderLevelStyle}" Content="弱提醒" Tag="Weak" />
                        <RadioButton x:Name="LevelNormal" GroupName="ReminderLevel" Style="{StaticResource ReminderLevelStyle}" Content="普通提醒" Tag="Normal" />
                        <RadioButton x:Name="LevelStrong" GroupName="ReminderLevel" Style="{StaticResource ReminderLevelStyle}" Content="强提醒" Tag="Strong" />
                        <RadioButton x:Name="LevelUltra" GroupName="ReminderLevel" Style="{StaticResource ReminderLevelStyle}" Content="超强提醒" Tag="Ultra" />
                    </UniformGrid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="32" Padding="8,0" Background="Transparent" BorderBrush="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}" Content="清除提醒" Click="ClearReminder_Click" />
                        <Button Grid.Column="2" Style="{StaticResource CommandButtonStyle}" Content="保存提醒" Click="SetReminder_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="10,0">
                <TextBlock x:Name="ReminderStatus" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SaveStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
