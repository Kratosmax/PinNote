<Window x:Class="PinNote.Windows.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinNote 便签管理" Width="940" Height="620" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#F4F7F8" SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#CBD3D6" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#10000000" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#1E000000" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#FAFCFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="20,16,12,8">
                <TextBlock Text="PinNote" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="便签管理" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
            </StackPanel>
            <ListBox x:Name="GroupList" Grid.Row="1" Margin="10,0" BorderThickness="0" Background="Transparent"
                     SelectionChanged="GroupList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="10,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <Grid Grid.Row="2" Margin="10,8,10,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource QuietButtonStyle}" Content="+ 新建分组" Click="AddGroup_Click" />
                <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource QuietButtonStyle}" Padding="0" Content="&#xE70F;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="重命名分组" Click="RenameGroup_Click" />
                <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource QuietButtonStyle}" Padding="0" Content="&#xE74D;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="删除分组" Click="DeleteGroup_Click" />
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="#D7DEE0" />

        <Grid Grid.Column="2" Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="PageTitle" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="全部便签" />
                <Border Grid.Column="1" Height="34" Margin="0,0,10,0" Background="White" BorderBrush="#CBD3D6" BorderThickness="1" CornerRadius="4">
                    <Grid><TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#7C858A" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBox x:Name="SearchBox" Margin="34,0,8,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" ToolTip="搜索标题或正文" /></Grid>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource CommandButtonStyle}" Content="+ 新建便签" Click="CreateNote_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,4,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="标题" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <TextBlock Grid.Column="2" Text="分组" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <TextBlock Grid.Column="3" Text="提醒" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                <TextBlock Grid.Column="4" Text="操作" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
            </Grid>

            <ListBox x:Name="NoteList" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="NoteList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#D7DEE0" BorderThickness="1" CornerRadius="5" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding VisibilityGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding VisibilityBrush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Preview}" Margin="0,2,14,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" Width="132" Height="30" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding DataContext.GroupChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Note.GroupId, Mode=TwoWay}"
                                          DropDownClosed="RowGroup_DropDownClosed" />
                                <TextBlock Grid.Column="3" Text="{Binding ReminderText}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="32" Height="30" Background="Transparent" BorderBrush="Transparent" Content="{Binding ToggleGlyph}"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="显示或隐藏" Click="ToggleVisibility_Click" />
                                    <Button Width="32" Height="30" Background="Transparent" BorderBrush="Transparent" Content="&#xE70F;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="打开编辑" Click="OpenNote_Click" />
                                    <Button Width="32" Height="30" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource DangerBrush}" Content="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="删除" Click="DeleteNote_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="CountText" Grid.Row="3" VerticalAlignment="Bottom" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
        </Grid>
    </Grid>
</Window>
