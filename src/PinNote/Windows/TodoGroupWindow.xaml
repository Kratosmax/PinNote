<Window x:Class="PinNote.Windows.TodoGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PinNote 待办" Width="430" Height="500" MinWidth="360" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource SurfaceBrush}" ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing"
        LocationChanged="Window_GeometryChanged" SizeChanged="Window_GeometryChanged" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TodoCheckStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid>
                <Ellipse x:Name="Ring" Fill="White" Stroke="{StaticResource BorderBrush}" StrokeThickness="1.5"/>
                <Path x:Name="Check" Data="M 5 11 L 9 15 L 17 7" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Fill" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TodoContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="TodoMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="Transparent"/>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#14147D76"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="FrameBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="48"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                        <Grid Background="#0C000000" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="新建分组并打开" Click="NewGroup_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border Grid.Column="1" Width="24" Height="30" Background="Transparent" Cursor="SizeAll" ToolTip="拖动待办窗口" MouseLeftButtonDown="DragGrip_MouseLeftButtonDown" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock Text="⠿" FontSize="16" Foreground="#7A626A70" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBox x:Name="GroupTitle" Grid.Column="2" Margin="2,4" Padding="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontWeight="SemiBold" FontSize="15" TextChanged="GroupTitle_TextChanged"/>
                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE8A7;" ToolTip="在管理页编辑" Click="OpenManager_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="MultiSelectButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE762;" ToolTip="多选" Click="MultiSelect_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="PinButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}" Content="&#xE718;" ToolTip="切换桌面/全局置顶" Click="PinButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" Content="&#xE711;" ToolTip="隐藏待办窗口" Click="Hide_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <Border x:Name="BatchBar" Grid.Row="1" Visibility="Collapsed" Background="#10147D76" BorderBrush="#30147D76" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Text="已选 0 项" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button x:Name="BatchReminderButton" Grid.Column="1" Height="32" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Content="统一设置提醒" Click="BatchReminder_Click"/>
                    <Button x:Name="BatchDeleteButton" Grid.Column="2" Height="32" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource DangerBrush}" Content="删除" Click="BatchDelete_Click"/><Button Grid.Column="3" Height="32" Style="{StaticResource SecondaryButtonStyle}" Content="取消" Click="CancelMultiSelect_Click"/>
                </Grid>
            </Border>

            <ListBox x:Name="TodoList" Grid.Row="2" Margin="8,6" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="TodoList_PreviewMouseLeftButtonDown" PreviewMouseMove="TodoList_PreviewMouseMove" DragOver="TodoList_DragOver" Drop="TodoList_Drop" DragLeave="TodoList_DragLeave" AllowDrop="True">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Border x:Name="RowBorder" MinHeight="44" Margin="{Binding Indent}" Background="{Binding DropBackground}" BorderBrush="{Binding DropBorder}" BorderThickness="{Binding DropThickness}" CornerRadius="3" Tag="{Binding}">
                        <Border.ContextMenu><ContextMenu Style="{StaticResource TodoContextMenuStyle}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource TodoMenuItemStyle}" Header="编辑" Click="ContextEdit_Click"/>
                            <MenuItem Style="{StaticResource TodoMenuItemStyle}" Header="增加" Click="ContextAdd_Click"/>
                            <MenuItem Style="{StaticResource TodoMenuItemStyle}" Header="设置提醒时间" Click="ContextReminder_Click"/>
                            <MenuItem Style="{StaticResource TodoMenuItemStyle}" Header="删除" Foreground="{StaticResource DangerBrush}" Click="ContextDelete_Click"/>
                            <Separator/><MenuItem Style="{StaticResource TodoMenuItemStyle}" Header="多选" Click="ContextMultiSelect_Click"/>
                        </ContextMenu></Border.ContextMenu>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="26"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectionVisibility}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="Selection_Click" ToolTip="选择"/>
                            <Button Grid.Column="1" Width="22" Height="28" Style="{StaticResource IconButtonStyle}" Content="{Binding ExpandGlyph}" Visibility="{Binding ExpandVisibility}" ToolTip="折叠或展开子级" Click="ToggleExpanded_Click"/>
                            <CheckBox Grid.Column="2" Style="{StaticResource TodoCheckStyle}" VerticalAlignment="Center" IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="Complete_Click" ToolTip="标记完成"/>
                            <Grid Grid.Column="3" Margin="2,5,4,5"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><TextBlock Text="{Binding Title}" Foreground="{Binding Foreground}" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding Title}" MouseLeftButtonDown="TodoTitle_MouseLeftButtonDown"/>
                                    <Border Height="1.5" Background="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" RenderTransformOrigin="0,0.5" Visibility="{Binding StrikeVisibility}">
                                        <Border.RenderTransform><ScaleTransform ScaleX="1"/></Border.RenderTransform>
                                        <Border.Style><Style TargetType="Border"><Style.Triggers>
                                            <DataTrigger Binding="{Binding AnimateStrike}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
                                        </Style.Triggers></Style></Border.Style>
                                    </Border>
                                </Grid><TextBlock Grid.Row="1" Text="{Binding ReminderText}" Foreground="{Binding ReminderBrush}" Margin="0,2,0,0" FontSize="11"/>
                            </Grid>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Width="28" Height="28" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="增加子级" Click="AddChild_Click"/>
                                <Button Width="28" Height="28" Style="{StaticResource IconButtonStyle}" Content="&#xE823;" ToolTip="设置提醒时间" Click="SetReminder_Click"/>
                                <Button Width="28" Height="28" Style="{StaticResource IconButtonStyle}" Foreground="{StaticResource DangerBrush}" Content="&#xE74D;" ToolTip="删除" Click="Delete_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="10,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                <TextBox x:Name="NewTodoBox" Height="34" Padding="9,0" VerticalContentAlignment="Center" ToolTip="输入后按回车新增待办" KeyDown="NewTodoBox_KeyDown"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource CommandButtonStyle}" Content="添加" Click="AddTodo_Click"/>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="4" Margin="12,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>
    </Border>
</Window>
