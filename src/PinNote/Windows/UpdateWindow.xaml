<Window x:Class="PinNote.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinNote 更新" Width="520" Height="440" MinWidth="460" MinHeight="390"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="Transparent" SourceInitialized="Window_SourceInitialized">
    <Border x:Name="RootSurface" Padding="28,24" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="发现新版本" />
                    <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Width="42" Height="42" Background="#18147D76" CornerRadius="6">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource PrimaryBrush}" Text="&#xE777;" />
                </Border>
            </Grid>

            <TextBlock Grid.Row="1" Margin="0,20,0,10" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Text="更新内容" />
            <Border Grid.Row="2" Background="#D7DEE0" />
            <ScrollViewer Grid.Row="3" Margin="0,12,0,16" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" LineHeight="21" />
            </ScrollViewer>

            <StackPanel Grid.Row="4" Margin="0,0,0,16">
                <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="100"
                             Visibility="Collapsed" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SkipButton" MinWidth="88" Height="34" Style="{StaticResource SecondaryButtonStyle}" Content="跳过此版本" Click="Skip_Click" />
                <Button x:Name="LaterButton" Grid.Column="2" MinWidth="76" Height="34" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}" Content="稍后" Click="Later_Click" />
                <Button x:Name="InstallButton" Grid.Column="3" MinWidth="102" Height="34"
                        Style="{StaticResource CommandButtonStyle}" Content="立即更新" Click="Install_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
