<Window x:Class="PinNote.Windows.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinNote 提醒" Width="620" Height="340" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="False" Topmost="True"
        ShowInTaskbar="True" SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">
    <Border x:Name="FrameBorder" BorderBrush="{StaticResource DangerBrush}" BorderThickness="4" CornerRadius="8"
            Background="{StaticResource SurfaceRaisedBrush}" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LevelText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE711;" ToolTip="关闭提醒" Click="Dismiss_Click" />
            </Grid>
            <TextBlock x:Name="TitleText" Grid.Row="1" Margin="0,18,0,8" FontSize="32" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="84" />
            <TextBlock x:Name="PreviewText" Grid.Row="2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="100" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="SnoozeButton" MinWidth="104" Height="36" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}" Content="稍后提醒"
                        Click="SnoozeMenu_Click">
                    <Button.ContextMenu>
                                                <ContextMenu Placement="Top" Padding="4"
                                     Background="{StaticResource SurfaceRaisedBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContextMenu.Resources>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Padding" Value="12,7" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#14147D76" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ContextMenu.Resources>
                            <MenuItem Header="5 分钟后" Tag="FiveMinutes" Click="SnoozePreset_Click" />
                            <MenuItem Header="30 分钟后" Tag="ThirtyMinutes" Click="SnoozePreset_Click" />
                            <MenuItem Header="1 小时后" Tag="OneHour" Click="SnoozePreset_Click" />
                            <Separator />
                            <MenuItem Header="明天早上 09:00" Tag="TomorrowMorning" Click="SnoozePreset_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button MinWidth="82" Height="36" Margin="0,0,8,0" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                        Content="忽略" Click="Dismiss_Click" />
                <Button MinWidth="92" Height="36" Style="{StaticResource CommandButtonStyle}" Content="完成" Click="Complete_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
