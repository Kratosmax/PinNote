<Window x:Class="PinNote.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinNote 设置" Width="500" Height="480" MinWidth="460" MinHeight="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="SemiBold" Text="设置" />

        <TextBlock Grid.Row="1" Margin="0,24,0,10" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Text="常规" />
        <StackPanel Grid.Row="2">
            <CheckBox x:Name="StartWithWindowsBox" Height="34" VerticalContentAlignment="Center" Content="开机时启动 PinNote" />
            <CheckBox x:Name="MaterialBox" Height="34" VerticalContentAlignment="Center" Content="使用系统毛玻璃材质" />
        </StackPanel>

        <Border Grid.Row="3" Margin="0,16,0,0" Background="#D7DEE0" />

        <TextBlock Grid.Row="4" Margin="0,20,0,10" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Text="全局快捷键" />

        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="NewNoteHotkeyEnabledBox" VerticalAlignment="Center" Content="新建便签" />
            <TextBox x:Name="NewNoteHotkeyBox" Grid.Column="1" Height="34" Padding="10,0" IsReadOnly="True"
                     IsEnabled="{Binding IsChecked, ElementName=NewNoteHotkeyEnabledBox}"
                     VerticalContentAlignment="Center" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                     ToolTip="聚焦后按下新的快捷键组合" />
            <Button Grid.Column="2" Width="34" Height="34" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}"
                    Content="&#xE777;" ToolTip="恢复默认 Ctrl+Shift+N" Click="ResetNewNoteHotkey_Click" />
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ManagerHotkeyEnabledBox" VerticalAlignment="Center" Content="打开管理页面" />
            <TextBox x:Name="ManagerHotkeyBox" Grid.Column="1" Height="34" Padding="10,0" IsReadOnly="True"
                     IsEnabled="{Binding IsChecked, ElementName=ManagerHotkeyEnabledBox}"
                     VerticalContentAlignment="Center" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                     ToolTip="聚焦后按下新的快捷键组合" />
            <Button Grid.Column="2" Width="34" Height="34" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}"
                    Content="&#xE777;" ToolTip="恢复默认 Ctrl+Shift+B" Click="ResetManagerHotkey_Click" />
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="7" Margin="0,14,0,0" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" FontSize="12" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="76" Height="34" Margin="0,0,8,0" Content="取消" Click="Cancel_Click" />
            <Button MinWidth="76" Height="34" Style="{StaticResource CommandButtonStyle}" Content="保存" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
