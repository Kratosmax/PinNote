<Window x:Class="PinNote.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="PinNote 设置" Width="680" Height="680" MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="Transparent" SourceInitialized="Window_SourceInitialized"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <x:Array x:Key="PriorityValues" Type="{x:Type sys:Int32}">
            <sys:Int32>0</sys:Int32><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32><sys:Int32>5</sys:Int32>
            <sys:Int32>6</sys:Int32><sys:Int32>7</sys:Int32><sys:Int32>8</sys:Int32>
            <sys:Int32>9</sys:Int32><sys:Int32>10</sys:Int32>
        </x:Array>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8,18,10" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" CornerRadius="4">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#0E000000" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#10147D76" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProxyGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#B8FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#D7DEE0" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E8EEF0" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D4E9E7" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProxyAddressTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ProxyAddressEditStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootSurface" Padding="24,20" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="22" FontWeight="SemiBold" Text="设置" />

            <TabControl x:Name="SettingsTabs" Grid.Row="1" Margin="0,16,0,12" Background="Transparent" BorderThickness="0">
                <TabItem Header="常规与快捷键">
                    <StackPanel Margin="14,18,14,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="常规" />
                        <CheckBox x:Name="StartWithWindowsBox" Height="38" Margin="0,8,0,0" VerticalContentAlignment="Center" Content="开机时启动 PinNote" />
                        <CheckBox x:Name="MaterialBox" Height="38" VerticalContentAlignment="Center" Content="使用 Windows 11 系统毛玻璃材质" />
                        <CheckBox x:Name="AutoCompleteParentTodoBox" Height="38" VerticalContentAlignment="Center"
                                  Content="子待办全部完成后自动完成父待办（不再询问）" />
                        <Border Height="1" Margin="0,14" Background="#D7DEE0" />
                        <TextBlock Margin="0,0,0,12" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="全局快捷键" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="NewNoteHotkeyEnabledBox" VerticalAlignment="Center" Content="新建便签" />
                            <TextBox x:Name="NewNoteHotkeyBox" Grid.Column="1" Height="34" Padding="10,0" IsReadOnly="True"
                                     IsEnabled="{Binding IsChecked, ElementName=NewNoteHotkeyEnabledBox}" VerticalContentAlignment="Center"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="聚焦后按下新的快捷键组合" />
                            <Button Grid.Column="2" Width="34" Height="34" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}"
                                    Content="&#xE777;" ToolTip="恢复默认 Ctrl+Shift+N" Click="ResetNewNoteHotkey_Click" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="ManagerHotkeyEnabledBox" VerticalAlignment="Center" Content="打开管理页面" />
                            <TextBox x:Name="ManagerHotkeyBox" Grid.Column="1" Height="34" Padding="10,0" IsReadOnly="True"
                                     IsEnabled="{Binding IsChecked, ElementName=ManagerHotkeyEnabledBox}" VerticalContentAlignment="Center"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="聚焦后按下新的快捷键组合" />
                            <Button Grid.Column="2" Width="34" Height="34" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}"
                                    Content="&#xE777;" ToolTip="恢复默认 Ctrl+Shift+B" Click="ResetManagerHotkey_Click" />
                        </Grid>
                    </StackPanel>
                </TabItem>

                <TabItem Header="网络与更新">
                    <Grid Margin="14,18,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="44" />
                            <RowDefinition Height="1" /><RowDefinition Height="62" /><RowDefinition Height="1" /><RowDefinition Height="68" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="GitHub 访问线路" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Width="34" Height="34" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" ToolTip="添加 GitHub 前缀线路" Click="AddProxy_Click" />
                                <Button Width="34" Height="34" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Content="&#xE738;" ToolTip="删除所选线路" Click="RemoveProxy_Click" />
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="GithubProxyGrid" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource ProxyGridStyle}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow" BeginningEdit="GithubProxyGrid_BeginningEdit">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="地址" Width="*" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource ProxyAddressTextStyle}" EditingElementStyle="{StaticResource ProxyAddressEditStyle}" />
                                <DataGridComboBoxColumn Header="优先级" Width="92" ItemsSource="{StaticResource PriorityValues}"
                                    SelectedItemBinding="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Text="10 到 1 按顺序尝试，0 表示禁用；同优先级按列表顺序。" />
                        <Border Grid.Row="3" Background="#D7DEE0" />
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="HTTP 网络代理" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="可选，不支持账号密码" />
                            </StackPanel>
                            <TextBox x:Name="HttpProxyBox" Grid.Column="1" Height="34" Padding="10,0" VerticalContentAlignment="Center"
                                     ToolTip="例如：http://127.0.0.1:7890" />
                        </Grid>
                        <Border Grid.Row="5" Background="#D7DEE0" />
                        <Grid Grid.Row="6">
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox x:Name="AutoUpdateBox" Height="30" VerticalContentAlignment="Center" Content="自动检查更新" />
                                <TextBlock x:Name="CurrentVersionText" Margin="24,0,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="UpdateStatusText" Margin="24,3,110,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="CheckUpdateButton" MinWidth="88" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButtonStyle}" Content="检查更新" Click="CheckUpdate_Click" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,0,0,10" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="76" Height="34" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Content="取消" Click="Cancel_Click" />
                <Button MinWidth="76" Height="34" Style="{StaticResource CommandButtonStyle}" Content="保存" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
